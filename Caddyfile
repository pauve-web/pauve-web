# Configuración del servidor web de Pauvè (Caddy)
# El servidor la carga desde /etc/caddy/Caddyfile mediante "import".

www.pauvestudio.com {
	redir https://pauvestudio.com{uri} permanent
}

pauvestudio.com {
	root * /var/www/pauve-web/public
	encode zstd gzip
	# Que el navegador compruebe siempre si hay una versión nueva de las páginas
	@paginas path / *.html */
	header @paginas Cache-Control "no-cache"
	file_server
}
